{
  "name": "webroti",
  "version": "1.0.0",
  "private": true,
  "description": "Measure the return on time invested (ROTI) in your meetings — anonymous 1–5 votes, average and min–max, on Cloudflare Pages + D1",
  "keywords": [
    "roti",
    "meetings",
    "retrospective",
    "feedback",
    "voting",
    "cloudflare-pages",
    "cloudflare-d1"
  ],
  "homepage": "https://github.com/CodeByAB/webroti#readme",
  "bugs": {
    "url": "https://github.com/CodeByAB/webroti/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodeByAB/webroti.git"
  },
  "license": "MIT",
  "author": "Daniel Valfridsson",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "npm run db:migrate:local && wrangler pages dev",
    "db:migrate:local": "wrangler d1 migrations apply webroti --local",
    "db:migrate:remote": "wrangler d1 migrations apply webroti --remote",
    "test": "node --test --disable-warning=ExperimentalWarning",
    "lint": "eslint . && prettier --check . && markdownlint-cli2",
    "format": "prettier --write .",
    "typecheck": "tsc -p . && tsc -p public/js",
    "check": "npm run lint && npm run typecheck && npm test",
    "setup": "lefthook install"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261107.1",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "lefthook": "2.2.2",
    "markdownlint-cli2": "0.24.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "wrangler": "4.158.0"
  }
}
